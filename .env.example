# Local settings. Copy to .env; never commit secrets.
APP_ENV=development
LLM_BACKEND=ollama
COMPOSE_PROFILES=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
GUARDRAIL_LEVEL=off
LLAMA_GUARD_BACKEND=cloudflare
LLAMA_GUARD_TIMEOUT_SECONDS=90
PROMPT_INJECTION_THRESHOLD=0.92
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_LLAMA_GUARD_MODEL=@cf/meta/llama-guard-3-8b
LLAMA_GUARD_MODEL=llama-guard3:1b
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=longcat-2.5-preview-free
OPENCODE_GO_API_KEY=
LLM_TIMEOUT_SECONDS=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://idt:idt_local_only@postgres:5432/idt
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-only-change-me
GITHUB_REPOSITORY=sjreal/idt
GITHUB_ACTIONS_WORKFLOW_FILE=ci.yml
GITHUB_ACTIONS_BRANCH=main
# Optional read-only Actions token for private repositories; public repos can omit it.
GITHUB_ACTIONS_TOKEN=
GITHUB_ACTIONS_POLL_SECONDS=300
