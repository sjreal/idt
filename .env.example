# Local settings. Copy to .env; never commit secrets.
APP_ENV=development
LLM_BACKEND=ollama
COMPOSE_PROFILES=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
GUARDRAIL_LEVEL=off
LLAMA_GUARD_BACKEND=cloudflare
LLAMA_GUARD_TIMEOUT_SECONDS=90
PROMPT_INJECTION_THRESHOLD=0.92
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_LLAMA_GUARD_MODEL=@cf/meta/llama-guard-3-8b
LLAMA_GUARD_MODEL=llama-guard3:1b
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4.1-flash
OPENCODE_GO_API_KEY=
LLM_TIMEOUT_SECONDS=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://idt:idt_local_only@postgres:5432/idt

# Telemetry — opt-in. Empty OTEL endpoint means no exporter traffic and no
# requirement to run Phoenix. Content capture is off by default.
# `make observability-up` uses docker-compose.observability.yml, which points
# this at the Phoenix collector base URL for you.
# This is a BASE url: exporters append the signal path, so spans go to
# /v1/traces. A full /v1/traces url also works.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=llm-guardrail-lab
OTEL_CAPTURE_CONTENT=false
TRACE_CAPTURE_CONTENT=false
TRACE_DIR=traces
TRACE_RETENTION_DAYS=7
TRACE_MAX_BYTES=50000000
PHOENIX_UI_URL=http://localhost:6006

# Phoenix collector auth. Off by default: the collector is only reachable from
# the compose network and is published on 127.0.0.1. To require a token, set
# PHOENIX_ENABLE_AUTH=true and PHOENIX_API_KEY, then send it from the app with
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <key>.
PHOENIX_ENABLE_AUTH=false
PHOENIX_API_KEY=

# Guardrail depth — plan matrix arms: off, prefilter, scanners, input,
# output, full, adaptive. Adaptive: score>=block -> block; <=allow -> pass;
# otherwise run the full plan.
PREFILTER_BLOCK_THRESHOLD=0.80
PREFILTER_ALLOW_THRESHOLD=0.20
ADAPTIVE_ENABLED=true

# Evaluation budget. Default is deliberately small; raise per run via
# max_requests in POST /api/evaluations/runs, never above the hard ceiling.
EVALUATION_DEFAULT_MAX_REQUESTS=60
EVALUATION_HARD_MAX_REQUESTS=300

# Routing / circuit breaker — comma-separated Chat Completions-compatible
# fallback models. Empty disables fallback entirely.
OPENCODE_GO_FALLBACK_MODELS=
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=60

# Hardening — auth is off for localhost with a boot warning; set a token
# before exposing the API anywhere else. Prompts are never logged by default.
API_AUTH_TOKEN=
RATE_LIMIT_PER_MINUTE=60
MAX_BODY_BYTES=1000000
LOG_PROMPTS=false
GENERATION_CONCURRENCY=2
TRUSTED_HOSTS=

# Observability links surfaced in the UI
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001

# Local Grafana credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-only-change-me

# CI exporter (read-only GitHub Actions metrics; public repos can omit the token)
GITHUB_REPOSITORY=sjreal/idt
GITHUB_ACTIONS_WORKFLOW_FILE=ci.yml
GITHUB_ACTIONS_BRANCH=main
GITHUB_ACTIONS_TOKEN=
GITHUB_ACTIONS_POLL_SECONDS=300
